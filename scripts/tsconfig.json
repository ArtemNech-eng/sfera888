{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // Без rootDir: пилот identity-preservation импортирует модули из
    // ../artifacts/api-server/src/lib (см. scripts/src/identity-preservation-pilot.ts).
    // Скрипты исполняются через tsx и не собираются через tsc, --noEmit, поэтому
    // отсутствие rootDir не влияет на эмит.
    "types": ["node"]
  },
  "include": ["src"]
}
