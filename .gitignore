# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Windows reserved names causing issues
nul

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Environment variables (secrets)
.env
.env.*
!.env.example

# Railway logs (contains tokens and runtime data)
RAILWAY_LOGS.md
railway-logs.txt

# AI Log Agent secrets
ai/.env

# Local-only debug files (never commit)
*.local
_run*.bat
_*.bat
_*.ps1
_*.out
*-out.txt

# One-off DB import/debug scripts that historically hardcoded credentials.
# Keep tracked utilities under scripts/src/ — these patterns target only the
# loose root-level *.cjs scripts that have been removed in this commit.
check-db.*
check-import.cjs
fix-arrays.cjs
fix-receipts.cjs
import-*.cjs
tmp-*.js
tmp-*.ts
