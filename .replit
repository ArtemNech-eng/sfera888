modules = ["nodejs-24", "postgresql-16"]

  [[artifacts]]
  id = "artifacts/api-server"

  [[artifacts]]
  id = "artifacts/mockup-sandbox"

  [deployment]
  router = "application"
  deploymentTarget = "vm"
  build = ["pnpm", "run", "build:prod"]
  run = ["node", "artifacts/api-server/dist/index.cjs"]

  [deployment.postBuild]
  args = ["sh", "-c", "CI=true pnpm prune --prod && pnpm store prune"]

  [workflows]
runButton = "Project"

  [agent]
  stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

  [postMerge]
  path = "scripts/post-merge.sh"
  timeoutMs = 20000

  [userenv]

[userenv.production]

[userenv.shared]
# NOTE: All secrets moved to environment variables only.
# Do NOT store credentials here — this file is in version control.
# Required env vars: SESSION_SECRET, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY,
# VAPID_EMAIL, ADMIN_PASSWORD, DATABASE_URL, etc.
# See RAILWAY_ENV_VARS.md for the full list.

  [nix]
  channel = "stable-25_05"
  