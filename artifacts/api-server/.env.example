# api-server environment variables
# Copy to .env (not committed) and fill in real values.

# ─── Anti-abuse: Yandex SmartCaptcha (форма /dizajn) ──────────────────────────
# Серверный ключ (Server key) из Yandex Cloud → SmartCaptcha → ваш виджет.
# Используется backend'ом для POST https://smartcaptcha.yandexcloud.net/validate.
# Если НЕ задан — verifyCaptchaToken пропускает запрос (dev/E2E bypass); в проде
# обязателен, иначе капча фактически выключена.
# Клиентский (Client) ключ задаётся на marketplace как NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY.
SMARTCAPTCHA_SERVER_KEY=

# ─── AI integration gateway (OpenAI-compatible: OpenAI / OpenRouter / proxy) ──
# Required to enable any AI feature (design pipeline, dispatcher, content helpers).
AI_INTEGRATIONS_OPENAI_API_KEY=your-api-key-here
# Optional: point at an OpenAI-compatible gateway (e.g. OpenRouter). Leave unset for OpenAI.
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Shared default model for the gateway (fallback for the design path below).
AI_INTEGRATIONS_OPENAI_MODEL=

# ─── Layout_Planner / design content model ───────────────────────────────────
# Model used by the AI_Design_Product pipeline (layoutPlanner.ts / designContent.ts).
# Resolution is read-fresh on every call (designConfig.getDesignModel):
#   AI_INTEGRATIONS_DESIGN_MODEL → AI_INTEGRATIONS_OPENAI_MODEL → reliable default.
#
# MUST be a model with first-class JSON-schema Structured Outputs
# (response_format: { type: "json_schema", strict: true }), otherwise the
# Layout_JSON schema is rejected and generations fail.
#
# Recommended (reliable structured-output default): gpt-4o-2024-08-06
AI_INTEGRATIONS_DESIGN_MODEL=gpt-4o-2024-08-06

# ─── AI design pipeline tuning (optional) ─────────────────────────────────────
# Edit-image provider for Angle_Render: gpt_image_1_5_edit | flux_kontext_pro
AI_DESIGN_EDIT_PROVIDER=
# Per-project AI budget ceiling, in kopeks (non-negative integer). Default 10000.
DESIGN_COST_CEILING_KOPEKS=

# ─── AI_Design_3D_Blockout (подход B2) — offline-пайплайн ─────────────────────
# Нужны для prototype.ts (R&D-прогон) и run-blockout.ts (полный пайплайн).
#
# fal.ai — перекраска depth-ControlNet. Ключ: https://fal.ai/dashboard/keys
FAL_API_KEY=
# Опц. модель depth-ControlNet (default fal-ai/flux-control-lora-depth/image-to-image)
FAL_MODEL_DEPTH_CONTROLNET=
#
# Cloudflare R2 (Object_Storage): загрузка карт глубины и результатов.
# Креды: Cloudflare → R2 → Manage R2 API Tokens (Object Read & Write).
R2_ENDPOINT=                       # https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=                     # https://pub-xxxx.r2.dev или привязанный домен
DEFAULT_OBJECT_STORAGE_BUCKET_ID=  # имя/ID бакета для артефактов блокаута
#
# Blender (Render_Environment) — только для run-blockout.ts; prototype.ts не нужен.
BLENDER_BIN=                       # путь к headless Blender 4.2+ (иначе ищется в PATH)
# Верхняя граница Cost_Budget B2 в копейках (default 6000 = ~$0.6).
DESIGN_COST_BUDGET_KOPEKS=
