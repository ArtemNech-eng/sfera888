{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "start": "node dist/index.cjs",
    "cleanup:r2": "tsx ./src/scripts/cleanup-orphaned-r2.ts",
    "cleanup:r2:apply": "tsx ./src/scripts/cleanup-orphaned-r2.ts --apply",
    "test": "tsx --test ./__tests__/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@google-cloud/storage": "^7.19.0",
    "@sparticuz/chromium-min": "131.0.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/pg": "^8.18.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "obscenity": "^0.4.3",
    "openai": "^6.29.0",
    "pg": "^8.20.0",
    "puppeteer-core": "24.0.0",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/sharp": "^0.32.0",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.3",
    "fast-check": "^4.8.0",
    "tsx": "catalog:"
  }
