# Windows без Developer Mode не позволяет создавать symlinks в node_modules,
# что ломает default pnpm node-linker=isolated. Hoisted режим раскладывает
# зависимости плоско в artifacts/marketplace/node_modules без symlinks —
# Next.js это полностью поддерживает.
# Этот .npmrc применяется только к локальной установке этого пакета и не
# затрагивает другие artifacts/lib.
node-linker=hoisted
