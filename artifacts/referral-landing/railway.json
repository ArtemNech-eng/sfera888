{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @workspace/referral-landing run build"
  },
  "deploy": {
    "startCommand": "pnpm dlx serve -s artifacts/referral-landing/dist/public -l $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
