{
 "$schema": "https://railway.app/railway.schema.json",
  "build": {
  "builder": "NIXPACKS",
  "buildCommand": "pnpm --filter @workspace/crm run build"
  },
  "deploy": {
  "startCommand": "pnpm dlx serve -s artifacts/crm/dist/public -l $PORT",
 "restartPolicyType": "ON_FAILURE",
 "restartPolicyMaxRetries": 10
 }
}
